{
  "name": "goat-browser",
  "version": "4.5.0",
  "description": "Goat Browser: private, fast Chromium browser",
  "main": "src/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "package:win": "npm run build && electron-packager . \"Goat Browser\" --platform=win32 --arch=x64 --out=dist --overwrite --asar --icon=build/icon.ico --ignore=^/dist --ignore=^/build --ignore=^/fast-build --executable-name=GoatBrowser",
    "build": "node scripts/patch-extensions.js && esbuild src/ui/preload.js --bundle --platform=node --format=cjs --external:electron --outfile=src/ui/preload.bundle.js",
    "postinstall": "node scripts/patch-extensions.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.2.3",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3",
    "electron-chrome-extensions": "^4.10.0",
    "electron-chrome-web-store": "^0.13.0",
    "openpgp": "^6.3.2",
    "tldts": "^7.4.19"
  },
  "productName": "Goat Browser"
}
