[Desktop Entry]
Type=Application
Name=Goat Browser
GenericName=Web Browser
Comment=A private, fast browser built on Chromium
Exec=goat-browser %U
Icon=goat-browser
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
StartupWMClass=Goat Browser
Actions=new-private-window;new-tor-window;

[Desktop Action new-private-window]
Name=New private window
Exec=goat-browser --goat-window=private

[Desktop Action new-tor-window]
Name=New Tor window
Exec=goat-browser --goat-window=tor
