#!/bin/sh
# Goat Browser (Chromium) AppImage launcher.
THIS="$(readlink -f "$0")"
HERE="$(dirname "$THIS")"
APP="$HERE/opt/goat-browser"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/goat-browser"

# Goat's helper (Tor, settings) for the Goat extension. The AppImage mount path
# changes every start, so the manifest is rewritten each time.
mkdir -p "$CONF/NativeMessagingHosts"
sed "s|\"goat-host.exe\"|\"$APP/goat/goat-host.py\"|" "$APP/goat/host-manifest.json" \
  > "$CONF/NativeMessagingHosts/com.goat.host.json"

# Startup settings from Goat settings (Balanced until changed).
[ -f "$CONF/settings.switches" ] || cp "$APP/goat/settings.switches.default" "$CONF/settings.switches"
SETTINGS="$(tr -d '\r' < "$CONF/settings.switches" 2>/dev/null | grep -E '^--[a-z0-9-]+(=[A-Za-z0-9,]+)?$' | tr '\n' ' ')"

# Chromium's sandbox needs unprivileged user namespaces (an AppImage can't ship
# the setuid helper). If the system blocks them (Ubuntu 24.04+), run without it.
SANDBOX=""
if [ -r /proc/sys/kernel/apparmor_restrict_unprivileged_userns ] && \
   [ "$(cat /proc/sys/kernel/apparmor_restrict_unprivileged_userns)" = "1" ]; then
  SANDBOX="--no-sandbox"
elif command -v unshare >/dev/null 2>&1 && ! unshare -Ur true >/dev/null 2>&1; then
  SANDBOX="--no-sandbox"
fi
if [ -n "$SANDBOX" ]; then
  echo "Goat Browser: this system blocks unprivileged user namespaces, so Chromium's sandbox is off." >&2
  echo "Goat Browser: to turn it on: sudo sysctl -w kernel.apparmor_restrict_unprivileged_userns=0" >&2
fi

export CHROME_WRAPPER="$THIS"
# shellcheck disable=SC2086
exec "$APP/chrome" --class=goat-browser $SANDBOX $SETTINGS "$@"
