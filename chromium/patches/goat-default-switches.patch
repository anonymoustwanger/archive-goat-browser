+// Goat: default switches. The browser process reads "switches.txt" (shipped
+// with Goat) and "settings.switches" (written by Goat settings) from the
+// "goat" folder next to the executable. One switch per line, e.g.
+// "--load-extension={goat}/ext/goat"; "{goat}" is replaced with that folder.
+// Switches given on the real command line win, except list switches, which
+// are merged.
+void AddGoatDefaultSwitches(base::CommandLine* command_line) {
+  if (command_line->HasSwitch(switches::kProcessType)) {
+    return;
+  }
+  base::FilePath exe_dir;
+  if (!base::PathService::Get(base::DIR_EXE, &exe_dir)) {
+    return;
+  }
+  const base::FilePath goat_dir = exe_dir.Append(FILE_PATH_LITERAL("goat"));
+  const std::string goat_path = goat_dir.AsUTF8Unsafe();
+  for (const base::FilePath::CharType* name :
+       {FILE_PATH_LITERAL("switches.txt"),
+        FILE_PATH_LITERAL("settings.switches")}) {
+    std::string text;
+    if (!base::ReadFileToStringWithMaxSize(goat_dir.Append(name), &text,
+                                           64 * 1024)) {
+      continue;
+    }
+    for (std::string_view raw :
+         base::SplitStringPiece(text, "\r\n", base::TRIM_WHITESPACE,
+                                base::SPLIT_WANT_NONEMPTY)) {
+      if (raw.size() < 3 || !base::StartsWith(raw, "--")) {
+        continue;
+      }
+      std::string line(raw.substr(2));
+      base::ReplaceSubstringsAfterOffset(&line, 0, "{goat}", goat_path);
+      const size_t eq = line.find('=');
+      const std::string name_str = base::ToLowerASCII(line.substr(0, eq));
+      const std::string value =
+          eq == std::string::npos ? std::string() : line.substr(eq + 1);
+      if (name_str.empty()) {
+        continue;
+      }
+      const bool is_list = name_str == "load-extension" ||
+                           name_str == "enable-features" ||
+                           name_str == "disable-features" ||
+                           name_str == "enable-blink-features" ||
+                           name_str == "disable-blink-features";
+      if (command_line->HasSwitch(name_str)) {
+        if (!is_list || value.empty()) {
+          continue;
+        }
+        std::string merged = command_line->GetSwitchValueUTF8(name_str);
+        merged = merged.empty() ? value : merged + "," + value;
+        command_line->RemoveSwitch(name_str);
+        command_line->AppendSwitchUTF8(name_str, merged);
+        continue;
+      }
+      if (value.empty()) {
+        command_line->AppendSwitch(name_str);
+      } else {
+        command_line->AppendSwitchUTF8(name_str, value);
+      }
+    }
+  }
+}
+
 }  // namespace
 
